---
import type { Locale, TranslationDict, ServicePillar } from '@/types/i18n';
import SectionHeading from './SectionHeading.astro';
import WaterRipple from '@/components/WaterRipple.astro';

interface Props {
  locale: Locale;
  t: TranslationDict;
}

const { locale, t } = Astro.props;
const s = t.services;
const waNumber = import.meta.env.PUBLIC_WA_NUMBER;
const waHref = `https://wa.me/${waNumber}?text=${encodeURIComponent(t.cta.waMessage)}`;

const icons: Record<ServicePillar['icon'], string> = {
  web: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  mobile: '<path stroke-linecap="round" stroke-linejoin="round" d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M11 18h2"/>',
  fullstack: '<path stroke-linecap="round" stroke-linejoin="round" d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
};

const features: Record<ServicePillar['icon'], string[]> = {
  web: locale === 'id'
    ? ['Landing page & company profile', 'Web app & e-commerce', 'Admin dashboard', 'SEO & performance optimized']
    : ['Landing pages & company profiles', 'Web apps & e-commerce', 'Admin dashboards', 'SEO & performance optimized'],
  mobile: locale === 'id'
    ? ['iOS & Android native feel', 'Cross-platform', 'Offline-first ready', 'App store deployment']
    : ['iOS & Android native feel', 'Cross-platform', 'Offline-first ready', 'App store deployment'],
  fullstack: locale === 'id'
    ? ['REST API & database design', 'Auth & role management', 'POS, booking, marketplace', 'Scalable architecture']
    : ['REST API & database design', 'Auth & role management', 'POS, booking, marketplace', 'Scalable architecture'],
};
---

<!-- Hero -->
<section class="relative overflow-hidden bg-surface py-24 lg:py-32">
  <div class="absolute -left-32 -top-40 h-[32rem] w-[32rem] rounded-full bg-primary-light blur-3xl opacity-80"></div>
  <div class="absolute -right-24 top-20 h-[28rem] w-[28rem] rounded-full bg-accent-light blur-3xl opacity-70"></div>
  <WaterRipple />
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {locale === 'id' ? 'Apa Yang Kami Kerjakan' : 'What We Do'}
      </p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] tracking-tight text-text sm:text-5xl lg:text-6xl">
        {s.hero.heading}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-text-muted">{s.hero.description}</p>
    </div>
  </div>
</section>

<!-- Pillar cards -->
<section class="bg-surface py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-3">
      {s.pillars.map((pillar, i) => (
        <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface-alt p-8 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-primary/5">
          <span class="absolute right-6 top-6 font-mono text-5xl font-bold text-border transition-colors group-hover:text-primary/15">
            0{i + 1}
          </span>
          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary text-white transition-transform group-hover:scale-110">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" set:html={icons[pillar.icon]} />
          </div>
          <h2 class="mt-6 text-2xl font-bold text-text">{pillar.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-muted">{pillar.description}</p>
          <ul class="mt-6 space-y-2.5 border-t border-border pt-6">
            {features[pillar.icon].map((f) => (
              <li class="flex items-start gap-2.5 text-sm text-text">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {f}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="relative overflow-hidden bg-primary py-24 lg:py-28">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
  <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-accent/30 blur-3xl" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.cta.heading}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/80">{s.cta.description}</p>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-9 inline-flex items-center gap-2 rounded-xl bg-white px-7 py-3.5 text-sm font-semibold text-primary shadow-lg transition-all hover:bg-surface-alt hover:shadow-xl active:scale-[0.98]"
    >
      {s.cta.button}
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
      </svg>
    </a>
  </div>
</section>
