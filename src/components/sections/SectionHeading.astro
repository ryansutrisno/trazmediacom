---
interface Props {
  heading: string;
  description?: string;
  align?: 'left' | 'center';
  eyebrow?: string;
}

const { heading, description, align = 'left', eyebrow } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">{eyebrow}</p>
  )}
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
    {heading}
  </h2>
  {description && (
    <p class:list={[
      'mt-5 text-lg leading-relaxed text-text-muted',
      align === 'center' && 'mx-auto'
    ]}>
      {description}
    </p>
  )}
</div>