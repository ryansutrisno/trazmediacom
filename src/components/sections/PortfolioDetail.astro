---
import type { Locale, TranslationDict, PortfolioItem } from '@/types/i18n';

interface Props {
  locale: Locale;
  t: TranslationDict;
  project: PortfolioItem;
}

const { locale, t, project } = Astro.props;
const backLabel = locale === 'id' ? 'Kembali ke Portofolio' : 'Back to Portfolio';
const viewLabel = locale === 'id' ? 'Lihat Project' : 'View Project';
const techLabel = locale === 'id' ? 'Tech Stack' : 'Tech Stack';
const categoryLabel = locale === 'id' ? 'Kategori' : 'Category';
---

<!-- Hero -->
<section class="relative overflow-hidden bg-surface-alt pt-16 lg:pt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <a
      href={`/${locale}/portfolio`}
      class="group inline-flex items-center gap-2 text-sm font-semibold text-text-muted transition-colors hover:text-primary"
    >
      <svg class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5 5-5M6 12h12" />
      </svg>
      {backLabel}
    </a>

    <div class="mt-8 max-w-3xl">
      <span class="inline-flex items-center rounded-full bg-primary-light px-3 py-1 text-xs font-semibold text-primary">
        {project.category}
      </span>
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.1] tracking-tight text-text sm:text-5xl">
        {project.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-text-muted">{project.tagline}</p>
    </div>

    <!-- Hero image -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-border bg-surface shadow-xl shadow-text/5">
      <img
        src={project.image}
        alt={project.title}
        width="1280"
        height="800"
        class="aspect-[16/9] w-full object-cover object-top"
      />
    </div>
  </div>
</section>

<!-- Body -->
<section class="bg-surface py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-16">
      <!-- Description -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-text">
          {locale === 'id' ? 'Tentang Project' : 'About the Project'}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-text-muted">{project.description}</p>

        <div class="mt-8">
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-hover hover:shadow-xl active:scale-[0.98]"
          >
            {viewLabel}
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Sidebar: meta -->
      <aside class="lg:col-span-1">
        <div class="rounded-2xl border border-border bg-surface-alt p-6">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-muted">{techLabel}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <span class="rounded-full bg-surface px-3 py-1.5 font-mono text-xs font-medium text-text border border-border">
                {tech}
              </span>
            ))}
          </div>

          <div class="mt-6 border-t border-border pt-6">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-text-muted">{categoryLabel}</h3>
            <p class="mt-2 text-sm font-semibold text-text">{project.category}</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>