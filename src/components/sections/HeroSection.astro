---
import type { Locale, TranslationDict } from '@/types/i18n';

interface Props {
  locale: Locale;
  t: TranslationDict;
}

const { locale, t } = Astro.props;
const waNumber = import.meta.env.PUBLIC_WA_NUMBER;
const waHref = `https://wa.me/${waNumber}?text=${encodeURIComponent(t.cta.waMessage)}`;
---

<section class="relative overflow-hidden bg-surface">
  <!-- Gradient mesh background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -left-32 -top-40 h-[32rem] w-[32rem] rounded-full bg-primary-light blur-3xl opacity-80"></div>
    <div class="absolute -right-24 top-20 h-[28rem] w-[28rem] rounded-full bg-accent-light blur-3xl opacity-70"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-surface"></div>
  </div>

  <!-- Subtle grid overlay -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true" style="background-image: linear-gradient(#1a1a2e 1px, transparent 1px), linear-gradient(90deg, #1a1a2e 1px, transparent 1px); background-size: 56px 56px;"></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-28 pt-8 sm:px-6 lg:px-8 lg:pb-32 lg:pt-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left: copy -->
      <div class="max-w-xl">
        <p class="reveal inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-4 py-1.5 text-sm font-medium text-primary backdrop-blur">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
          </span>
          {t.home.hero.greeting} <span class="font-semibold">{t.site.name}</span>
        </p>

        <h1 class="reveal mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight text-text sm:text-5xl lg:text-6xl">
          {t.home.hero.heading}
        </h1>

        <p class="reveal mt-6 text-lg leading-relaxed text-text-muted">
          {t.home.hero.description}
        </p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-4">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-hover hover:shadow-xl hover:shadow-primary/30 active:scale-[0.98]"
          >
            {t.home.hero.cta}
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
            </svg>
          </a>
          <a
            href={`/${locale}/portfolio`}
            class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-6 py-3.5 text-sm font-semibold text-text transition-all hover:border-text hover:bg-surface-alt"
          >
            {t.home.portfolioPreview.cta}
          </a>
        </div>
      </div>

      <!-- Right: code snippet visual -->
      <div class="reveal relative lg:justify-self-end min-w-0 w-full lg:w-auto">
        <div class="relative w-full min-w-[300px] sm:min-w-[380px] max-w-lg">
          <!-- Floating accent shapes -->
          <div class="absolute -right-6 -top-6 h-24 w-24 rounded-2xl bg-accent/10 backdrop-blur" aria-hidden="true"></div>
          <div class="absolute -bottom-8 -left-8 h-32 w-32 rounded-full border-2 border-dashed border-primary/20" aria-hidden="true"></div>

          <!-- Terminal window -->
          <div class="relative overflow-hidden rounded-2xl border border-border bg-[#0f1024] shadow-2xl shadow-text/10">
            <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
              <span class="h-3 w-3 rounded-full bg-[#ff5f56]"></span>
              <span class="h-3 w-3 rounded-full bg-[#ffbd2e]"></span>
              <span class="h-3 w-3 rounded-full bg-[#27c93f]"></span>
              <span class="ml-3 font-mono text-xs text-white/40">trazmedia.ts</span>
            </div>
            <pre id="terminal-code" class="relative w-full min-h-[180px] overflow-x-auto p-5 font-mono text-[11px] leading-relaxed sm:text-[13px]"><code><span class="text-[#a78bfa]">const</span> <span class="text-[#7dd3fc]">trazmedia</span> <span class="text-white/60">=</span> <span class="text-white/60">{'{'}</span>
  <span class="text-[#fcd34d]">founded</span>: <span class="text-[#86efac]">2017</span>,
  <span class="text-[#fcd34d]">base</span>: <span class="text-[#fda4af]">'Sleman, Yogyakarta'</span>,
  <span class="text-[#fcd34d]">stack</span>: <span class="text-white/60">[</span><span class="text-[#fda4af]">'React'</span>, <span class="text-[#fda4af]">'Astro'</span>, <span class="text-[#fda4af]">'Laravel'</span><span class="text-white/60">]</span>,
  <span class="text-[#fcd34d]">mission</span>: <span class="text-[#fda4af]">'Code that scales'</span>,
  <span class="text-[#a78bfa]">build</span>: <span class="text-white/60">(</span><span class="text-[#7dd3fc]">idea</span>: <span class="text-[#fda4af]">string</span><span class="text-white/60">)</span> <span class="text-[#a78bfa]">=&gt;</span>
    <span class="text-[#7dd3fc]">ship</span><span class="text-white/60">(</span><span class="text-[#7dd3fc]">design</span><span class="text-white/60">(</span><span class="text-[#7dd3fc]">code</span><span class="text-white/60">(</span><span class="text-[#7dd3fc]">idea</span><span class="text-white/60">)))</span>,
<span class="text-white/60">{'}'}</span></code><span id="terminal-cursor" class="inline-block h-[15px] w-[9px] animate-pulse bg-white/80 align-middle"></span></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function typeCode() {
    const pre = document.getElementById('terminal-code');
    const cursor = document.getElementById('terminal-cursor');
    if (!pre || !cursor) return;

    const code = pre.querySelector('code');
    if (!code) return;

    // Store original HTML, then clear
    const original = code.innerHTML;
    code.innerHTML = '';
    cursor.style.display = 'inline-block';

    let i = 0;
    const speed = 70; // ms per character

    function type() {
      if (i >= original.length) {
        code.innerHTML = original;
        cursor.style.display = 'none';
        return;
      }
      // Keep HTML structure: append characters until we hit < or >
      let chunk = '';
      while (i < original.length && original[i] !== '<') {
        chunk += original[i];
        i++;
      }
      if (i < original.length && original[i] === '<') {
        // Collect full HTML tag
        const tagStart = i;
        while (i < original.length && original[i] !== '>') {
          i++;
        }
        if (i < original.length) {
          i++; // include the closing >
          chunk = original.substring(0, i);
        }
      }
      code.innerHTML = chunk + '<span class="text-white/50">|</span>';
      setTimeout(type, speed);
    }

    // Start when visible
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        observer.disconnect();
        setTimeout(type, 300);
      }
    }, { threshold: 0.2 });

    observer.observe(pre);
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.addEventListener('DOMContentLoaded', typeCode);
  } else {
    const cursor = document.getElementById('terminal-cursor');
    if (cursor) cursor.style.display = 'none';
  }
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: reveal-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .reveal:nth-child(1) { animation-delay: 0.05s; }
  .reveal:nth-child(2) { animation-delay: 0.15s; }
  .reveal:nth-child(3) { animation-delay: 0.25s; }
  .reveal:nth-child(4) { animation-delay: 0.35s; }
  .reveal:nth-child(5) { animation-delay: 0.45s; }
  @keyframes reveal-up {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; animation: none; }
  }
</style>