---
import { getImage } from 'astro:assets';
import type { Locale, TranslationDict } from '@/types/i18n';
import WaterRipple from '@/components/WaterRipple.astro';

interface Props {
  locale: Locale;
  t: TranslationDict;
}

const { locale, t } = Astro.props;
const p = t.portfolio;
const waNumber = import.meta.env.PUBLIC_WA_NUMBER;
const waHref = `https://wa.me/${waNumber}?text=${encodeURIComponent(t.cta.waMessage)}`;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/project-images/*.png', { eager: true });
const imageMap = new Map(
  Object.entries(images).map(([key, value]) => [key.replace('/src/assets', ''), value.default])
);

const optimizedImages = new Map<string, string>();
for (const [key, image] of imageMap) {
  const optimized = await getImage({ src: image, width: 480, height: 300, format: 'webp' });
  optimizedImages.set(key, optimized.src);
}
---

<!-- Hero -->
<section class="relative overflow-hidden bg-surface py-24 lg:py-32">
  <div class="absolute -left-32 -top-40 h-[32rem] w-[32rem] rounded-full bg-primary-light blur-3xl opacity-80"></div>
  <div class="absolute -right-24 top-20 h-[28rem] w-[28rem] rounded-full bg-accent-light blur-3xl opacity-70"></div>
  <WaterRipple />
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {locale === 'id' ? 'Karya Kami' : 'Our Work'}
      </p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] tracking-tight text-text sm:text-5xl lg:text-6xl">
        {p.hero.heading}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-text-muted">{p.hero.description}</p>
    </div>
  </div>
</section>

<!-- Grid -->
<section class="bg-surface py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {p.projects.map((project) => (
        <a
          href={`/${locale}/portfolio/${project.slug}`}
          class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-text/5"
        >
          <div class="relative aspect-[16/10] overflow-hidden bg-surface-alt">
            {optimizedImages.has(project.image) && (
              <img
                src={optimizedImages.get(project.image)!}
                alt={project.title}
                width="480"
                height="300"
                class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-text/70 via-text/0 to-text/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-3 py-1 text-xs font-semibold text-text backdrop-blur">
              {project.category}
            </span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h2 class="text-lg font-bold text-text transition-colors group-hover:text-primary">{project.title}</h2>
            <p class="mt-1.5 text-sm text-text-muted">{project.tagline}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tech.slice(0, 3).map((tech) => (
                <span class="rounded-full bg-surface-alt px-2.5 py-1 font-mono text-[11px] font-medium text-text-muted">{tech}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="relative overflow-hidden bg-surface-alt py-20">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <p class="text-lg font-semibold text-text sm:text-xl">{p.cta}</p>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-hover hover:shadow-xl active:scale-[0.98]"
    >
      {t.home.ctaBanner.button}
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
      </svg>
    </a>
  </div>
</section>
