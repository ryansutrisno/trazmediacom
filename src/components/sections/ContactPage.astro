---
import type { Locale, TranslationDict } from '@/types/i18n';
import WaterRipple from '@/components/WaterRipple.astro';

interface Props {
  locale: Locale;
  t: TranslationDict;
}

const { locale, t } = Astro.props;
const c = t.contact;
const waNumber = import.meta.env.PUBLIC_WA_NUMBER;
const email = import.meta.env.PUBLIC_EMAIL;
const waHref = `https://wa.me/${waNumber}?text=${encodeURIComponent(t.cta.waMessage)}`;
const emailHref = `mailto:${email}`;
---

<!-- Hero -->
<section class="relative overflow-hidden bg-surface py-24 lg:py-32">
  <div class="absolute -left-32 -top-40 h-[32rem] w-[32rem] rounded-full bg-primary-light blur-3xl opacity-80"></div>
  <div class="absolute -right-24 top-20 h-[28rem] w-[28rem] rounded-full bg-accent-light blur-3xl opacity-70"></div>
  <WaterRipple />
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {locale === 'id' ? 'Hubungi Kami' : 'Get in Touch'}
      </p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] tracking-tight text-text sm:text-5xl lg:text-6xl">
        {c.hero.heading}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-text-muted">{c.hero.description}</p>
    </div>
  </div>
</section>

<!-- Contact cards -->
<section class="bg-surface py-24 lg:py-28">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      <!-- WhatsApp card -->
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface p-8 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-[#25D366]/10"
      >
        <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-[#25D366]/10 blur-2xl transition-opacity group-hover:opacity-100" aria-hidden="true"></div>
        <div class="relative flex h-14 w-14 items-center justify-center rounded-xl bg-[#25D366]/10 text-[#25D366]">
          <svg class="h-7 w-7 fill-[#25D366]" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
          </svg>
        </div>
        <h2 class="relative mt-6 text-2xl font-bold text-text">{c.wa.heading}</h2>
        <p class="relative mt-3 flex-1 text-sm leading-relaxed text-text-muted">{c.wa.description}</p>
        <span class="relative mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#25D366]">
          {c.wa.button}
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5" />
          </svg>
        </span>
      </a>

      <!-- Email card -->
      <a
        href={emailHref}
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface p-8 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-primary/10"
      >
        <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-primary-light blur-2xl" aria-hidden="true"></div>
        <div class="relative flex h-14 w-14 items-center justify-center rounded-xl bg-primary-light text-primary">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
        </div>
        <h2 class="relative mt-6 text-2xl font-bold text-text">{c.email.heading}</h2>
        <p class="relative mt-3 flex-1 text-sm leading-relaxed text-text-muted">{c.email.description}</p>
        <p class="relative mt-4 font-mono text-sm text-text">{email}</p>
        <span class="relative mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary">
          {c.email.button}
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
