---
import type { Locale, TranslationDict } from '@/types/i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
  t: TranslationDict;
}

const { locale, t } = Astro.props;
const f = t.faq;
---

<section class="bg-surface-alt py-24 lg:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <SectionHeading heading={f.heading} description={f.description} align="center" />

    <div class="mt-12 space-y-3">
      {f.items.map((item, i) => (
        <details class="faq-item group rounded-2xl border border-border bg-surface transition-colors open:border-primary/30 open:shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6">
            <span class="flex items-center gap-4">
              <span class="font-mono text-sm font-bold text-primary/60">0{i + 1}</span>
              <span class="text-base font-semibold text-text">{item.question}</span>
            </span>
            <span class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-alt text-text-muted transition-all group-open:rotate-45 group-open:bg-primary group-open:text-white">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </span>
          </summary>
          <div class="faq-content px-6 pb-6">
            <p class="pl-10 text-sm leading-relaxed text-text-muted">{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-content {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.35s ease, opacity 0.3s ease, padding 0.3s ease;
  }
  .faq-item[open] .faq-content {
    max-height: 400px;
    opacity: 1;
  }
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ''; }
  @media (prefers-reduced-motion: reduce) {
    .faq-content { transition: none; }
  }
</style>