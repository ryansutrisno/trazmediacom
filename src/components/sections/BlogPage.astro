---
import type { Locale, TranslationDict } from '@/types/i18n';
import WaterRipple from '@/components/WaterRipple.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import type { BlogPostSummary } from '@/components/blog/types';

interface Props {
  locale: Locale;
  t: TranslationDict;
  posts?: BlogPostSummary[];
}

const { locale, t, posts = [] } = Astro.props;
const b = t.blog;
const headingRowEyebrow = locale === 'id' ? 'Blog' : 'Blog';
const headingRowHeading = locale === 'id' ? 'Artikel Terbaru' : 'Latest Articles';
const countLabel =
  locale === 'id'
    ? `${posts.length} artikel`
    : `${posts.length} article${posts.length === 1 ? '' : 's'}`;
const comingTopics =
  locale === 'id' ? ['Web Development', 'Mobile Apps', 'Strategi Digital'] : ['Web Development', 'Mobile Apps', 'Digital Strategy'];
---

<!-- Hero -->
<section class="relative overflow-hidden bg-surface py-24 lg:py-32">
  <div class="absolute -left-32 -top-40 h-[32rem] w-[32rem] rounded-full bg-primary-light blur-3xl opacity-80"></div>
  <div class="absolute -right-24 top-20 h-[28rem] w-[28rem] rounded-full bg-accent-light blur-3xl opacity-70"></div>
  <WaterRipple />
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {locale === 'id' ? 'Insight & Artikel' : 'Insights & Articles'}
      </p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] tracking-tight text-text sm:text-5xl lg:text-6xl">
        {b.hero.heading}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-text-muted">{b.hero.description}</p>
    </div>
  </div>
</section>

<!-- Listing -->
{
  posts.length > 0 ? (
    <section class="bg-surface py-24 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Section heading row -->
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-primary">{headingRowEyebrow}</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight text-text">{headingRowHeading}</h2>
          </div>
          <span class="rounded-full border border-border bg-surface-alt px-3.5 py-1.5 text-xs font-semibold text-text-muted">
            {countLabel}
          </span>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard post={post} locale={locale} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-surface py-24 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Empty state -->
        <div class="relative mx-auto max-w-2xl overflow-hidden rounded-3xl border border-border bg-surface-alt px-6 py-16 text-center sm:px-12">
          <div class="pointer-events-none absolute -left-16 -top-16 h-56 w-56 rounded-full bg-primary-light opacity-70 blur-2xl"></div>
          <div class="pointer-events-none absolute -bottom-20 -right-14 h-56 w-56 rounded-full bg-accent-light opacity-70 blur-2xl"></div>
          <div class="relative">
            <span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl border border-border bg-surface shadow-lg shadow-text/5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-8 w-8 text-primary" aria-hidden="true">
                <rect x="4" y="3" width="16" height="18" rx="2.5"></rect>
                <path d="M8 8h8M8 12h8M8 16h5" stroke-linecap="round"></path>
              </svg>
            </span>
            <h2 class="mt-8 text-3xl font-bold tracking-tight text-text sm:text-4xl">{b.placeholder.heading}</h2>
            <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-text-muted">{b.placeholder.description}</p>
            <div class="mt-8 flex flex-wrap justify-center gap-2" aria-hidden="true">
              {comingTopics.map((topic) => (
                <span class="rounded-full border border-border bg-surface px-3.5 py-1.5 font-mono text-[11px] font-medium text-text-muted">{topic}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
