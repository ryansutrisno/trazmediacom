---
import type { Locale } from '@/types/i18n';
import { formatDate, readingTimeLabel, isoDate } from './format';
import type { BlogPostSummary } from './types';

interface Props {
  post: BlogPostSummary;
  locale: Locale;
}

const { post, locale } = Astro.props;
const dateLabel = formatDate(locale, post.publishDate);
const publishIso = isoDate(post.publishDate);
const readingLabel = readingTimeLabel(locale, post.readingTime);
const tags = post.tags.slice(0, 3);

// Deterministic gradient variant per post so a card's cover stays stable across renders
const variant = [...post.slug].reduce((acc, ch) => acc + ch.charCodeAt(0), 0) % 3;
const gradients = [
  'bg-gradient-to-br from-primary-light via-surface to-accent-light',
  'bg-gradient-to-bl from-accent-light via-surface to-primary-light',
  'bg-gradient-to-tr from-primary-light via-accent-light to-surface',
];
---

<a
  href={`/${locale}/blog/${post.slug}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-text/5"
>
  <!-- Cover -->
  <div class="relative aspect-[16/10] overflow-hidden bg-surface-alt">
    {
      post.cover ? (
        <img
          src={post.cover}
          alt={post.title}
          class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="absolute inset-0" aria-hidden="true">
          <div class:list={['absolute inset-0', gradients[variant]]}></div>
          <div class="absolute -right-10 -top-14 h-44 w-44 rounded-full bg-primary/10 blur-2xl transition-transform duration-500 ease-out group-hover:scale-110"></div>
          <div class="absolute -bottom-12 -left-8 h-40 w-40 rounded-full bg-accent/10 blur-2xl"></div>
          <div class="absolute inset-0 grid place-items-center">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              class="h-16 w-16 text-primary/30 transition-transform duration-500 ease-out group-hover:scale-110"
            >
              <rect x="4" y="3" width="16" height="18" rx="2.5"></rect>
              <path d="M8 8h8M8 12h8M8 16h5" stroke-linecap="round"></path>
            </svg>
          </div>
        </div>
      )
    }
    <div
      class="absolute inset-0 bg-gradient-to-t from-text/70 via-text/0 to-text/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"
    ></div>
    <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-3 py-1 text-xs font-semibold text-text backdrop-blur">
      {post.category}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-6">
    <h2 class="text-lg font-bold leading-snug text-text transition-colors group-hover:text-primary">{post.title}</h2>
    <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-text-muted">{post.description}</p>

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-surface-alt px-2.5 py-1 font-mono text-[11px] font-medium text-text-muted">{tag}</span>
        ))}
      </div>
    )}

    <div class="grow" aria-hidden="true"></div>

    <!-- Meta footer -->
    <div class="mt-6 flex items-center justify-between gap-3 border-t border-border pt-4 text-xs text-text-muted">
      <span class="inline-flex min-w-0 items-center gap-1.5">
        <svg class="h-3.5 w-3.5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
        </svg>
        <time class="truncate" datetime={publishIso}>{dateLabel}</time>
      </span>
      <span class="inline-flex shrink-0 items-center gap-1.5">
        <svg class="h-3.5 w-3.5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"></path>
        </svg>
        <span class="whitespace-nowrap">{readingLabel}</span>
      </span>
    </div>
  </div>
</a>
