---
import type { Locale, TranslationDict } from '@/types/i18n';
import { getAlternateLocale } from '@i18n/index';

interface Props {
  locale: Locale;
  t: TranslationDict;
}

const { locale, t } = Astro.props;
const altLocale = getAlternateLocale(locale);
const pathname = Astro.url.pathname.replace(/\/$/, ''); // strip trailing slash
const altPath = pathname.replace(/^\/(id|en)/, '') || '';

// Active link detection: normalize current path without locale prefix
const currentPath = pathname.replace(/^\/(id|en)/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
};
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-border/60 bg-surface/80 backdrop-blur-xl transition-all duration-300"
  data-navbar
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href={`/${locale}/`} class="flex items-center gap-2 transition-opacity hover:opacity-80" aria-label={t.site.name}>
      <img src="/logo.svg" alt={t.site.name} class="h-8 w-auto" width="126" height="40" />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 md:flex">
      {t.nav.map((item) => (
        <li>
          <a
            href={`/${locale}${item.href === '/' ? '/' : item.href}`}
            class:list={[
              'relative rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-primary'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-primary"></span>
            )}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right side: language switch + mobile toggle -->
    <div class="flex items-center gap-2">
      <a
        href={`/${altLocale}${altPath === '' ? '/' : altPath}`}
        class="group flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted transition-colors hover:border-primary hover:text-primary"
        aria-label={`Switch to ${altLocale}`}
      >
        <span class="opacity-60 group-hover:opacity-100">{locale}</span>
        <span aria-hidden="true" class="text-border">↔</span>
        <span class="text-text group-hover:text-primary">{altLocale}</span>
      </a>

      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-text transition-colors hover:bg-surface-alt md:hidden"
        aria-label="Open menu"
        data-menu-open
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Spacer so content doesn't hide behind fixed navbar -->
<div class="h-16" aria-hidden="true"></div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.querySelector('[data-menu-open]');
    openBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('traz:menu-open'));
    });
  });
</script>