---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslations } from '@i18n/index';
import type { Locale } from '@/types/i18n';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import MobileMenu from '@components/layout/MobileMenu.tsx';
import AboutSection from '@components/sections/AboutSection.astro';

const locale: Locale = 'id';
const t = getTranslations(locale);
---

<BaseLayout locale={locale} t={t} title={t.about.hero.heading} description={t.about.hero.description}>
  <Navbar locale={locale} t={t} />
  <MobileMenu locale={locale} t={t} client:load />
  <main>
    <AboutSection locale={locale} t={t} />
  </main>
  <Footer locale={locale} t={t} />
</BaseLayout>