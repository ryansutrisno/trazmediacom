---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslations } from '@i18n/index';
import type { Locale } from '@/types/i18n';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import MobileMenu from '@components/layout/MobileMenu.tsx';
import BlogPage from '@components/sections/BlogPage.astro';
import { getCollection } from 'astro:content';
import type { BlogPostSummary } from '@components/blog/types';
import { isPublished } from '@components/blog/format';

export const prerender = false;

const locale: Locale = 'id';
const t = getTranslations(locale);
const now = new Date();
const posts: BlogPostSummary[] = (await getCollection('blogId'))
  .filter(({ data }) => !data.draft && isPublished(data.publishDate, now))
  .map(({ id, data }) => ({
    slug: id,
    title: data.title,
    description: data.description,
    publishDate: data.publishDate,
    category: data.category,
    tags: data.tags,
    readingTime: data.readingTime,
    cover: data.cover,
  }))
  .sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime());
---

<BaseLayout locale={locale} t={t} title={t.blog.hero.heading} description={t.blog.hero.description}>
  <Navbar locale={locale} t={t} />
  <MobileMenu locale={locale} t={t} client:load />
  <main>
    <BlogPage locale={locale} t={t} posts={posts} />
  </main>
  <Footer locale={locale} t={t} />
</BaseLayout>
