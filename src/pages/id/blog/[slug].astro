---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslations } from '@i18n/index';
import type { Locale } from '@/types/i18n';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import MobileMenu from '@components/layout/MobileMenu.tsx';
import BlogDetail from '@components/sections/BlogDetail.astro';
import type { BlogPostDetail } from '@components/blog/types';
import { isPublished } from '@components/blog/format';
import { absoluteUrl } from '@/lib/seo';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blogId');
  const now = new Date();
  return posts
    .filter(({ data }) => !data.draft && isPublished(data.publishDate, now))
    .map((post) => ({ params: { slug: post.id } }));
}

const locale: Locale = 'id';
const t = getTranslations(locale);
const { slug } = Astro.params;
const entry = (await getCollection('blogId')).find((candidate) => candidate.id === slug);

if (!entry) {
  throw new Error(`Unknown blog post: ${slug}`);
}

const { Content } = await render(entry);
const post: BlogPostDetail = {
  slug: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  publishDate: entry.data.publishDate,
  updatedDate: entry.data.updatedDate,
  author: entry.data.author,
  category: entry.data.category,
  tags: entry.data.tags,
  keywords: entry.data.keywords,
  readingTime: entry.data.readingTime,
  cover: entry.data.cover,
};
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updatedDate ?? post.publishDate).toISOString(),
  author: { '@type': 'Person', name: post.author },
  publisher: {
    '@type': 'Organization',
    name: 'Trazmedia',
    logo: { '@type': 'ImageObject', url: 'https://trazmedia.com/logo.svg' },
  },
  image: post.cover ? absoluteUrl(post.cover) : undefined,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  keywords: post.keywords,
};
---

<BaseLayout locale={locale} t={t} title={post.title} description={post.description} image={post.cover} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.publishDate.toISOString()} />
    <meta property="article:modified_time" content={(post.updatedDate ?? post.publishDate).toISOString()} />
    <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  </Fragment>
  <Navbar locale={locale} t={t} />
  <MobileMenu locale={locale} t={t} client:load />
  <main>
    <BlogDetail locale={locale} t={t} post={post} Content={Content} />
  </main>
  <Footer locale={locale} t={t} />
</BaseLayout>
