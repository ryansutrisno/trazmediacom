---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslations } from '@i18n/index';
import type { Locale } from '@/types/i18n';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import MobileMenu from '@components/layout/MobileMenu.tsx';
import ContactPage from '@components/sections/ContactPage.astro';
import FAQSection from '@components/sections/FAQSection.astro';

const locale: Locale = 'en';
const t = getTranslations(locale);
---

<BaseLayout locale={locale} t={t} title={t.contact.hero.heading} description={t.contact.hero.description}>
  <Navbar locale={locale} t={t} />
  <MobileMenu locale={locale} t={t} client:load />
  <main>
    <ContactPage locale={locale} t={t} />
    <FAQSection locale={locale} t={t} />
  </main>
  <Footer locale={locale} t={t} />
</BaseLayout>