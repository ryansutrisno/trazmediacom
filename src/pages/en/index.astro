---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslations } from '@i18n/index';
import type { Locale } from '@/types/i18n';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import MobileMenu from '@components/layout/MobileMenu.tsx';
import WAFloatingButton from '@components/layout/WAFloatingButton.tsx';
import HeroSection from '@components/sections/HeroSection.astro';
import ServiceCards from '@components/sections/ServiceCards.astro';
import PortfolioGrid from '@components/sections/PortfolioGrid.astro';
import CTABanner from '@components/sections/CTABanner.astro';

const locale: Locale = 'en';
const t = getTranslations(locale);
const waNumber = import.meta.env.PUBLIC_WA_NUMBER;
---

<BaseLayout locale={locale} t={t} title={t.site.name} description={t.site.description}>
  <Navbar locale={locale} t={t} />
  <MobileMenu locale={locale} t={t} client:load />
  <main>
    <HeroSection locale={locale} t={t} />
    <ServiceCards locale={locale} t={t} />
    <PortfolioGrid locale={locale} t={t} limit={4} />
    <CTABanner locale={locale} t={t} />
  </main>
  <Footer locale={locale} t={t} />
  <WAFloatingButton waNumber={waNumber} message={t.cta.waMessage} client:load />
</BaseLayout>