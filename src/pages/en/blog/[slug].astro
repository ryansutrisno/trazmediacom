---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslations } from '@i18n/index';
import type { Locale } from '@/types/i18n';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import MobileMenu from '@components/layout/MobileMenu.tsx';
import BlogDetail from '@components/sections/BlogDetail.astro';
import type { BlogPostDetail } from '@components/blog/types';
import { isPublished } from '@components/blog/format';

export const prerender = false;

const locale: Locale = 'en';
const t = getTranslations(locale);
const { slug } = Astro.params;
const entry = (await getCollection('blogEn')).find((candidate) => candidate.id === slug);

if (!entry || entry.data.draft || !isPublished(entry.data.publishDate)) {
  return new Response('Not Found', { status: 404 });
}

const { Content } = await render(entry);
const post: BlogPostDetail = {
  slug: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  publishDate: entry.data.publishDate,
  updatedDate: entry.data.updatedDate,
  author: entry.data.author,
  category: entry.data.category,
  tags: entry.data.tags,
  keywords: entry.data.keywords,
  readingTime: entry.data.readingTime,
  cover: entry.data.cover,
};
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updatedDate ?? post.publishDate).toISOString(),
  author: { '@type': 'Person', name: post.author },
  publisher: {
    '@type': 'Organization',
    name: 'Trazmedia',
    logo: { '@type': 'ImageObject', url: 'https://trazmedia.com/logo.svg' },
  },
  image: post.cover ? new URL(post.cover, Astro.url.origin).href : undefined,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  keywords: post.keywords,
};
---

<BaseLayout locale={locale} t={t} title={post.title} description={post.description} image={post.cover}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  </Fragment>
  <Navbar locale={locale} t={t} />
  <MobileMenu locale={locale} t={t} client:load />
  <main>
    <BlogDetail locale={locale} t={t} post={post} Content={Content} />
  </main>
  <Footer locale={locale} t={t} />
</BaseLayout>
