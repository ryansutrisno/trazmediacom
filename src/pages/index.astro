---
import { getPreferredLocale } from '@/i18n';

export const prerender = false;

// Detect visitor locale: Vercel geo-IP header → Accept-Language → default ID.
// Non-Indonesian countries (e.g. Europe) get /en, Indonesia gets /id.
const country = (Astro.request.headers.get('x-vercel-ip-country') || '').toUpperCase();
const acceptLang = Astro.request.headers.get('accept-language') || '';
const locale = country === 'ID' ? 'id' : country ? 'en' : getPreferredLocale(acceptLang, 'id');

// Server-side redirect so the locale is decided before anything is rendered,
// avoiding a flash of the wrong page and keeping the response cacheable.
return Astro.redirect(`/${locale}/`, 302);
---
